    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "chrome-devtools-mcp@latest"
      ]
    },
    "playwright-localhost3000-kan": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest",
        "--isolated",
        "--storage-state=/Users/kan/.config/playwrightAuth/localhost3000-kan.json",
        "--save-session"
      ]
    }
  },
