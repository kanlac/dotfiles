#!/bin/zsh
# make ci publishes running/terminal notes; preview/main require the latest success.
# Historical targets require the locked billing guard and full hosted checks (~80-94 minutes).
# Both paths keep the 1800-minute cap. Note-only pushes do not trigger Actions.
root=$(git rev-parse --show-toplevel) || exit 1
ci_python="$root/.venv/bin/python"
[[ -x "$ci_python" ]] || ci_python=python3
cd "$root" || exit 1
if [[ -f "$root/tools/pre_push.py" ]]; then
  exec "$ci_python" -m tools.pre_push "$@"
fi
# Installed exact copy of tools/pre_push.py supports pre-architecture checkouts.
exec "$ci_python" "$(git rev-parse --git-common-dir)/hooks/tutti-pre-push.py" "$@"
