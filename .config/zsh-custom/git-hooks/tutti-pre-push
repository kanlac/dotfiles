#!/bin/zsh
# 推 main / preview 会触发 GitHub Actions 部署。本月 Actions 已用分钟数达到上限前就停下，
# 免得再次用满免费额度（2000 分钟/月，Kan 11-01 定：超过 1500 分钟停止推送并提醒）。
LIMIT=${TUTTI_ACTIONS_LIMIT:-1500}
hits=0
while read -r _ _ remote_ref _; do
  [[ $remote_ref == refs/heads/main || $remote_ref == refs/heads/preview ]] && hits=1
done
(( hits )) || exit 0
used=$(gh api "/users/kanlac/settings/billing/usage/summary?year=$(date +%Y)&month=$(date +%-m)" \
  --jq '[.usageItems[] | select(.product=="Actions" and (.sku|startswith("actions_")) and .unitType=="minutes") | .grossQuantity] | add // 0' 2>/dev/null)
if [[ -z $used ]]; then
  print -u2 "pre-push: 读不到本月 Actions 用量（gh 需 user 权限），照常推送，请自己留意额度。"
  exit 0
fi
if (( used >= LIMIT )); then
  print -u2 "pre-push: 本月 Actions 已用 ${used} 分钟，达到 ${LIMIT} 分钟上限，停止推送 main/preview。确需推送：TUTTI_ACTIONS_LIMIT=2000 git push ..."
  exit 1
fi
print -u2 "pre-push: 本月 Actions 已用 ${used} 分钟（上限 ${LIMIT}）。"
exit 0
